{
  "expo": {
    "name": "cleanflowapp",
    "slug": "cleanflowapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cleanflow-icon.png",
    "scheme": "cleanflowapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.iot.cleanflowapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación para registrar tu posición."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CleanFlow necesita acceso a tu cámara para reportar contenedores.",
          "photoLibraryPermission": "CleanFlow necesita acceso a tus fotos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8c83bec-28f9-4ad1-a704-48988c37a301"
      }
    },
    "owner": "deyvigo",
    "ios": {
      "bundleIdentifier": "com.iot.cleanflowapp"
    }
  }
}
